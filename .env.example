# WeatherNext Pro — Environment Variables Template
# Copy to .env and fill in your keys

# Google Maps Weather API (WeatherNext 2 backend)
GMAPS_API_KEY=your-google-maps-api-key

# Gemini AI (optional, for narrative generation)
GEMINI_API_KEY=your-gemini-api-key

# Telegram alerts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Polymarket (for live trading only)
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Trading mode
PAPER_TRADING=true
DEBUG=true
LOG_LEVEL=INFO
